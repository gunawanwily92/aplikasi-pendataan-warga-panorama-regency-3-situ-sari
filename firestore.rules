rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi data rumah & warga sensus Blok D
    match /houses/{houseId} {
      allow read, write: if true;
    }
    
    // Koleksi jadwal ronda malam poskamling
    match /ronda_schedules/{scheduleId} {
      allow read, write: if true;
    }
    
    // Koleksi presensi kehadiran ronda malam
    match /ronda_attendance/{attendanceId} {
      allow read, write: if true;
    }
    
    // Koleksi catatan mutasi warga pindah
    match /moved_citizens/{citizenId} {
      allow read, write: if true;
    }
    
    // Koleksi catatan warga meninggal
    match /deceased_citizens/{deceasedId} {
      allow read, write: if true;
    }
    
    // Koleksi arsip surat pengantar & agenda surat
    match /cover_letters/{letterId} {
      allow read, write: if true;
    }
    
    // Koleksi daftar kamera CCTV Blok D
    match /cctv_cameras/{cameraId} {
      allow read, write: if true;
    }
    
    // Koleksi log insiden pemantauan CCTV Blok D
    match /cctv_incident_logs/{logId} {
      allow read, write: if true;
    }
    
    // Konfigurasi sistem umum
    match /system_config/{configId} {
      allow read, write: if true;
    }
  }
}
